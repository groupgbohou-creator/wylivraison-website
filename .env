# ─────────────────────────────────────────────────────────────────────────────
# Liens et coordonnées du site vitrine Woudy (valeurs de PRODUCTION).
#
# Vite charge ce fichier pour tous les modes ; `.env.development` surcharge
# certaines valeurs quand on lance `npm run dev` (liens de test).
# Ces valeurs sont publiques (elles finissent dans le HTML/JS du site) :
# ne jamais mettre de secret ici.
#
# Après modification : commit + push sur `main` → Coolify redéploie woudys.com.
# ─────────────────────────────────────────────────────────────────────────────

# Promesse de délai de livraison affichée sur le site (en minutes)
VITE_DELIVERY_MINUTES=10

# Portails web
VITE_PARTNER_PORTAL_URL=https://woudy-partenaire.woudys.com
VITE_PARTNER_REGISTER_URL=https://woudy-partenaire.woudys.com/auth/register

# Stores. iOS vide = bouton « Bientôt sur l'App Store » ; les liens Android doivent être renseignés.
# Application client (commander un repas).
VITE_CLIENT_APP_IOS_URL=
VITE_CLIENT_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.delivery.woudy

# Application livreur (Woudy Livreur). iOS vide = pas de bouton App Store dans « Je livre ».
VITE_COURIER_APP_IOS_URL=
VITE_COURIER_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=ci.woudy.livreur

# Contact
VITE_WHATSAPP_NUMBER=2250720584171
VITE_WHATSAPP_DISPLAY="+225 07 20 58 41 71"
VITE_PHONE_NUMBER=+2252731944568
VITE_PHONE_DISPLAY="+225 27 31 94 45 68"
VITE_EMAIL_INFO=info@woudys.com
VITE_EMAIL_SUPPORT=support@woudys.com

# Réseaux sociaux
VITE_INSTAGRAM_URL=https://instagram.com/woudylivraison
VITE_INSTAGRAM_HANDLE=@woudylivraison
